# Not needed for local development: `docker compose up -d` works on a fresh clone
# using the dev defaults in compose.yaml. Copy this to .env only to override them.
# The CI/CD pipeline writes its own .env on the server. Never commit .env.
#
# Read twice, and that is deliberate: docker compose expands these into the app
# container, and application.yml imports the file directly so `mvn spring-boot:run`
# on the host lands on the same credentials. One file, both ways of running.
#
# Values are read as .properties, so a backslash is an escape character.
POSTGRES_DB=fitness_db
POSTGRES_USER=fitness
POSTGRES_PASSWORD=

# At least 32 bytes: it signs every session token. The compose default is for
# development only and must be overridden on the server.
JWT_SECRET=

# Origin of the SPA. On the server it is http://<host>:5173, not localhost.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP for the two-factor and password recovery codes. Leave empty to work
# without a mail server: the code is written to the application log instead.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
